PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Postgres connection strings (Supabase: pooled for the app, direct for migrations)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

JWT_SECRET=replace_with_a_long_random_string

# Get a key at https://console.groq.com/keys - required for fit-score computation
GROQ_API_KEY=your_groq_key_here
# Optional override - see server/src/ai/matching.service.ts for context
# GROQ_MODEL=openai/gpt-oss-20b

# Supabase Storage (for resume upload) - NOT the same as DATABASE_URL above.
# Find both at: Supabase Dashboard -> Project Settings -> API
# SUPABASE_URL is the "Project URL", SUPABASE_SERVICE_ROLE_KEY is the
# "service_role" secret key (never the anon/public key - this one bypasses
# RLS and must never reach the client). Resume upload returns 503 until both
# are set.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Cron expression for the periodic notification sweep (deadline reminders,
# reopen alerts) - see src/jobs/notificationScheduler.ts. Defaults to every
# 6 hours if unset. Example for local testing: "*/1 * * * *" (every minute).
# NOTIFICATION_CRON=0 */6 * * *
